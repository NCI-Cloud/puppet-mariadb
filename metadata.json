{
    "name": "ncicloud-mariadb",
    "version": "1.4.0",
    "author": "NCI Cloud Team",
    "summary": "Installs, configures and manages Mariadb servers",
    "description": "Installs, configures and manages Mariadb servers",
    "license": "Apache-2.0",
    "source": "https://github.com/NCI-Cloud/puppet-mariadb",
    "issues_url": "https://github.com/NCI-Cloud/puppet-mariadb/issues",
    "dependencies": [
        {
            "name": "puppetlabs/xinetd",
            "version_requirement": ">=1.5.0 <4.0.0"
        },
        {
            "name": "puppetlabs/mysql",
            "version_requirement": ">=8.0.0"
        },
        {
            "name": "puppetlabs/stdlib",
            "version_requirement": ">=4.0.0"
        },
        {
            "name": "puppetlabs/apt",
            "version_requirement": ">=9.2.0 <12.0.0"
        }
    ],
    "operatingsystem_support": [
        {
            "operatingsystem": "Debian",
            "operatingsystemrelease": [
                "9",
                "10",
                "11"
            ]
        },
        {
            "operatingsystem": "Fedora",
            "operatingsystemrelease": [
                "24"
            ]
        },
        {
            "operatingsystem": "RedHat",
            "operatingsystemrelease": [
                "7",
                "8",
                "9",
                "10"
            ]
        },
        {
            "operatingsystem": "Ubuntu",
            "operatingsystemrelease": [
                "18.04",
                "20.04",
                "22.04",
                "24.04"
            ]
        }
    ],
    "requirements": [
        {
            "name": "puppet",
            "version_requirement": "6.x"
        }
    ]
}
