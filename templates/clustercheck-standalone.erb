#!/bin/bash
#
# This script checks if a mysql/mariadb server is running on the specified
# bind address and port. It will return:
#
# "HTTP/1.x 200 OK\r" (if mysql is running smoothly)
#
# - OR -
#
# "HTTP/1.x 500 Internal Server Error\r" (else)
#
# The purpose of this script is make haproxy capable of monitoring mysql
# properly. This version will simply check whether mysql is responding to
# connections without error, which is suitable for checking the status of
# a standalone server.
#
# Original author: Unai Rodriguez
# Modified by various people since then.
#
# It is recommended that a user with minimal privileges is created to be used by
# this script. Something like this:
#
# mysql> CREATE USER 'clustercheckuser'@'localhost' \
#     -> IDENTIFIED BY 'clustercheckpassword!';
# mysql> GRANT USAGE on *.* TO 'clustercheckuser'@'localhost';
# mysql> flush privileges;
#
# Note that this script explicitly connects via a local socket, so the
# bind address (if any) is irrelevant.
#

# simple test for whether we can connect and run the simplest of queries.
mysql_opts=(
"--protocol=SOCKET"
"--host=localhost"
"--user=<%= @status_user %>"
"--password=<%= @status_password %>"
)
if mysql "${mysql_opts[@]}" -e "select 1;" &>/dev/null
then
    # mysql is fine, return http 200
    /bin/echo -e "HTTP/1.1 200 OK\r\n"
    /bin/echo -e "Content-Type: text/plain\r\n"
    /bin/echo -e "Content-Length: 19\r\n"
    /bin/echo -e "\r\n"
    /bin/echo -e "Node is running.\r\n"
    /bin/echo -e "\r\n"
else
    # mysql is fine, return http 503
    /bin/echo -e "HTTP/1.1 503 Service Unavailable\r\n"
    /bin/echo -e "Content-Type: text/plain\r\n"
    /bin/echo -e "Content-Length: 18\r\n"
    /bin/echo -e "\r\n"
    /bin/echo -e "Node is *down*.\r\n"
    /bin/echo -e "\r\n"
fi

sleep 1
