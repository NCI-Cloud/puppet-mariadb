#!/bin/bash
#
# This script checks if a mariadb/galera server is running on the specified
# bind address and port, and is a full cluster member. It will return:
#
# "HTTP/1.x 200 OK\r" (if mysql is running and a full cluster member)
#
# - OR -
#
# "HTTP/1.x 500 Internal Server Error\r" (else)
#
# The purpose of this script is allow haproxy to check the status of nodes
# in a mariadb/galera cluster. This version verifies that the node is a
# fully synchronised cluster member, which is suitable for checking if a
# cluster node is able to serve clients normally.
#
# Original author: Unai Rodriguez
# Modified by various people since then.
#
# It is recommended that a user with limited privileges is created to be used by
# this script. Something like this:
#
# mysql> CREATE USER 'clustercheckuser'@'localhost' \
#     -> IDENTIFIED BY 'clustercheckpassword!';
# mysql> GRANT USAGE on *.* TO 'clustercheckuser'@'localhost';
# mysql> flush privileges;
#
# Note that this script explicitly connects via a local socket, so the
# bind address (if any) is irrelevant.
#

# standard opts, -B means batch mode with tab separated output, -N skips
# printing column names - the result is one line per row of output, and
# two tab separated values per row.
mysql_opts=(
"-NB"
"--protocol=SOCKET"
"--host=localhost"
"--user=<%= @status_user %>"
"--password=<%= @status_password %>"
)

# these queries tell us whether the node is currently acting as a full
# member of a galera cluster.
#
# Note: wsrep_cluster_address='gcomm://' is the bootstrap state for a
# cluster node, so regardless of whether it's joined the cluster fully
# it's not considered up.
wsrep_query="show status like 'wsrep_local_state';"
gcomm_query="show variables like 'wsrep_cluster_address';"

WSSREP_STATUS=$(mysql "${mysql_opts[@]}" -e "$wsrep_query" | awk '{if (NR!=0){print $2}}' 2>/dev/null)
GCOMM_ADDRESS=$(mysql "${mysql_opts[@]}" -e "$gcomm_query" | awk '{if (NR!=0){print $2}}' 2>/dev/null)

if [ "$WSSREP_STATUS" == "4" ] && [ "$GCOMM_ADDRESS" != 'gcomm://' ]
then
    # mysql is fine, return http 200
    /bin/echo -e "HTTP/1.1 200 OK\r\n"
    /bin/echo -e "Content-Type: text/plain\r\n"
    /bin/echo -e "Content-Length: 19\r\n"
    /bin/echo -e "\r\n"
    /bin/echo -e "Node is running.\r\n"
    /bin/echo -e "\r\n"
else
    # mysql is fine, return http 503
    /bin/echo -e "HTTP/1.1 503 Service Unavailable\r\n"
    /bin/echo -e "Content-Type: text/plain\r\n"
    /bin/echo -e "Content-Length: 18\r\n"
    /bin/echo -e "\r\n"
    /bin/echo -e "Node is *down*.\r\n"
    /bin/echo -e "\r\n"
fi

sleep 1
